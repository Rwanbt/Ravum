// Outil de transformation de fichiers : Unicode, fs, Result, codes de sortie.
use std::env;
use std::fs;
use std::io;

fn main() -> Result<(), Error> {
    let args = env::args();
    if args.len() != 3 {
        io::println("usage: file-tool <input> <output>");
        return Ok(());
    }
    let input = fs::read_to_string(&args[1])?;
    let output = input.to_uppercase();
    fs::write_string(&args[2], &output)?;
    io::println("done");
    Ok(())
}
