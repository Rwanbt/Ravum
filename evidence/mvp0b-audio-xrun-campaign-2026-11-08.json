  "method": {
    "detector": "MissedPeriodCounter: max over the measured window of max(stall_deficit, played_deficit), where stall_deficit = wall_expected_frames - position_frames and played_deficit = position_frames - supplied_frames, both relative to a baseline taken at the first measured observation",
    "wasapi_clock": "IAudioClock::GetPosition + GetFrequency, obtained with IAudioClient::GetService(IID_IAudioClock); frames = position * rate / frequency (observed frequency 48 000 exclusive PCM16, 384 000 shared float32 -> factor 8)",
    "waveout_clock": "waveOutGetPosition(TIME_SAMPLES) treated as frames (validated by the observed drift staying below one period)",
    "period_frames": "WASAPI shared: engine event period (480 frames at 48 kHz / 10 ms); WASAPI exclusive: app-owned buffer duration (480 frames / 10 ms); waveOut: buffer size (512 frames / 10.67 ms)",
    "baseline": "first measured observation; constant device latency, exclusive-mode pre-roll and engine warm-up are excluded",
    "granularity": "one period; a non-zero missed_periods proves at least that many periods were missed, zero does not prove the absence of sub-period glitches",
    "injection_validation": "a diagnostic sleep (--inject-underrun-ms) once in the measured window forces a real underrun; the detector reported 12 / 11 / 14 missed periods for 120 / 120 / 150 ms sleeps on exclusive / shared / waveOut"
  },
