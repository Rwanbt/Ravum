{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ravum",
  "scopeName": "source.ravum",
  "fileTypes": ["rv"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ravum",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ravum",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ravum",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.ravum", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.ravum",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.ravum", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ravum",
          "match": "\\b(?:0x[0-9A-Fa-f_]+|0b[01_]+|0o[0-7_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][-+]?\\d+)?)(?:_?[A-Za-z][A-Za-z0-9]*)?\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.ravum",
          "match": "#\\[[^\\]]*\\]"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ravum",
          "match": "\\b(?:if|else|while|loop|for|in|match|return|break|continue)\\b"
        },
        {
          "name": "keyword.other.ravum",
          "match": "\\b(?:fn|let|mut|const|struct|enum|impl|trait|use|mod|pub|as|type|effect|effects|unsafe|extern|where|dyn)\\b"
        },
        {
          "name": "constant.language.ravum",
          "match": "\\b(?:true|false|self|Self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ravum",
          "match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|isize|usize|f32|f64|bool|char|str|unit)\\b"
        },
        {
          "name": "entity.name.type.ravum",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.ravum",
          "match": "(?<=\\bfn\\s+)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    }
  }
}
