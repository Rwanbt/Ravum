// T9 vertical (D-19-8): an HTTP/1.1 service that stores notes in SQLite.
//
// The server runs on its own thread with its own connection and answers
// `requests` requests, one connection per request (HTTP-1.4):
//   POST /notes   body = the note text  -> 201, `created <id>`
//   GET  /notes                        -> 200, one `<id> <text>` per line
//   anything else                      -> 404 / 405
// `main` is the client: it drives a fixed scenario on 127.0.0.1, port 0, and
// prints what it receives, so the whole run is reproducible. With any
// argument (`-- --async`) the server is the asynchronous one instead.
use std::env;
use std::http;
use std::io;
use std::net;
use std::task;
use std::thread;


fn note_lines(db: &sqlite::Db) -> Result<String, Error> effects(alloc, panic, unsafe, ffi) {
    let rows: Vec<sqlite::Row> = sqlite::query(db, "SELECT id, body FROM notes ORDER BY id DESC", Vec::new())?;
    let mut rest: Vec<sqlite::Row> = rows;
    let mut text: String = String::new();
    let mut done: bool = false;
    while !done {
        let next: Option<sqlite::Row> = rest.pop();
        match next {
            Some(row) => {
                let mut values: Vec<sqlite::Value> = row.values;
                let body: sqlite::Value = values.pop().unwrap();
                let id: sqlite::Value = values.pop().unwrap();
                match id {
                    sqlite::Value::Int(n) => text.push_str(n.to_string().as_str()),
                    _ => text.push_str("?"),
                }
                text.push_str(" ");
                match body {
                    sqlite::Value::Text(t) => text.push_str(t.as_str()),
                    _ => text.push_str("?"),
                }
                text.push_str("\n");
            }
            None => {
                done = true;
            }
        }
    }
    Ok(text)
}

// The answer to one request, shared by the blocking and the asynchronous
// server (RFC-ASYNC-NET-1 ANET-T2: both must answer byte for byte alike).
fn answer(db: &sqlite::Db, request: &HttpRequest) -> Result<(u16, String), Error> effects(alloc, panic, unsafe, ffi) {
    let method: String = http::method(request);
    let path: String = http::path(request);
    if path.as_str() != "/notes" {
        return Ok((404u16, String::from("not found\n")));
    }
    if method.as_str() == "POST" {
        let mut params: Vec<sqlite::Value> = Vec::new();
        params.push(sqlite::Value::Text(http::body(request)));
        let changed: i64 = sqlite::execute(db, "INSERT INTO notes (body) VALUES (?1)", params)?;
        drop(changed);
        let rows: Vec<sqlite::Row> = sqlite::query(db, "SELECT last_insert_rowid()", Vec::new())?;
        let mut rest: Vec<sqlite::Row> = rows;
        let mut reply: String = String::from("created ");
        match rest.pop() {
            Some(row) => {
                let mut values: Vec<sqlite::Value> = row.values;
                match values.pop() {
                    Some(sqlite::Value::Int(n)) => reply.push_str(n.to_string().as_str()),
                    _ => reply.push_str("?"),
                }
            }
            None => reply.push_str("?"),
        }
        reply.push_str("\n");
        return Ok((201u16, reply));
    }
    if method.as_str() == "GET" {
        let text: String = note_lines(db)?;
        return Ok((200u16, text));
    }
    Ok((405u16, String::from("method not allowed\n")))
}

fn handle(db: &sqlite::Db, stream: &mut TcpStream) -> Result<(), Error> effects(net, alloc, panic, unsafe, ffi) {
    let request: HttpRequest = http::read_request(stream)?;
    match answer(db, &request)? {
        (status, body) => http::respond(stream, status, "text/plain", body.as_str()),
    }
}

fn serve_all(db: &sqlite::Db, listener: &TcpListener, requests: i32) -> () effects(net, alloc, panic, unsafe, ffi) {
    let mut served: i32 = 0;
    while served < requests {
        match net::accept(listener) {
            Ok(conn) => {
                let mut stream: TcpStream = conn;
                let outcome: Result<(), Error> = handle(db, &mut stream);
                if outcome.is_err() {
                    let sent: Result<(), Error> = http::respond(&mut stream, 500, "text/plain", "error\n");
                    drop(sent);
                }
            }
            Err(e) => drop(e),
        }
        served = served + 1;
    }
}

fn serve(job: (TcpListener, i32)) -> () effects(net, alloc, panic, unsafe, ffi) {
    match job {
        (listener, requests) => {
            let db: sqlite::Db = sqlite::open_memory().unwrap();
            let made: i64 = sqlite::execute(&db, "CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL)", Vec::new()).unwrap();
            drop(made);
            serve_all(&db, &listener, requests);
            sqlite::close(db);
        }
    }
}

// The same service on the single-threaded executor (`--async`): the
// connection is owned by value, since an `async fn` binds no reference.
async fn handle_async(db: sqlite::Db, stream: TcpStream) -> sqlite::Db effects(net, async, alloc, panic, unsafe, ffi) {
    let mut s: TcpStream = stream;
    let reply: Result<(u16, String), Error> = match http::read_request_async(&mut s).await {
        Ok(request) => answer(&db, &request),
        Err(e) => Err(e),
    };
    match reply {
        Ok((status, body)) => drop(http::respond_async(&mut s, status, "text/plain", body.as_str()).await),
        Err(e) => drop(http::respond_async(&mut s, 500, "text/plain", "error\n").await),
    }
    return db;
}

async fn serve_all_async(db: sqlite::Db, listener: TcpListener, requests: i32) -> sqlite::Db effects(net, async, alloc, panic, unsafe, ffi) {
    let mut db: sqlite::Db = db;
    let mut served: i32 = 0;
    while served < requests {
        match net::accept_async(&listener).await {
            Ok(conn) => {
                db = handle_async(db, conn).await;
            }
            Err(e) => drop(e),
        }
        served = served + 1;
    }
    return db;
}

fn serve_async(job: (TcpListener, i32)) -> () effects(net, async, alloc, panic, unsafe, ffi) {
    match job {
        (listener, requests) => {
            let db: sqlite::Db = sqlite::open_memory().unwrap();
            let made: i64 = sqlite::execute(&db, "CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL)", Vec::new()).unwrap();
            drop(made);
            let db: sqlite::Db = task::block_on(serve_all_async(db, listener, requests));
            sqlite::close(db);
        }
    }
}

fn call(base: &str, method: &str, path: &str, body: &str) -> Result<(), Error> effects(io, net, alloc) {
    let mut url: String = String::from(base);
    url.push_str(path);
    let response: HttpResponse = if method == "POST" {
        http::post(url.as_str(), "text/plain", body)?
    } else {
        http::get(url.as_str())?
    };
    let mut line: String = String::from(method);
    line.push_str(" ");
    line.push_str(path);
    line.push_str(" -> ");
    line.push_str(http::status(&response).to_string().as_str());
    io::println(line.as_str());
    io::print(http::response_body(&response).as_str());
    Ok(())
}

fn main() -> Result<(), Error> effects(io, net, thread, async, alloc, panic, unsafe, ffi) {
    let listener: TcpListener = net::listen("127.0.0.1:0")?;
    let mut base: String = String::from("http://127.0.0.1:");
    base.push_str(net::local_port(&listener).to_string().as_str());
    let asynchronous: bool = env::args().len() > 1usize;
    let server: JoinHandle<()> = if asynchronous {
        thread::spawn(serve_async, (listener, 6))
    } else {
        thread::spawn(serve, (listener, 6))
    };
    call(base.as_str(), "POST", "/notes", "buy milk")?;
    call(base.as_str(), "POST", "/notes", "'); DROP TABLE notes; --")?;
    call(base.as_str(), "GET", "/notes", "")?;
    call(base.as_str(), "GET", "/missing", "")?;
    call(base.as_str(), "POST", "/missing", "x")?;
    call(base.as_str(), "GET", "/notes", "")?;
    thread::join(server);
    Ok(())
}
