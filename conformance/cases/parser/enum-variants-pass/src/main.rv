enum Shape {
    Circle(f64),
    Rect { w: f64, h: f64 },
    Empty,
}

fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => 3.0 * r * r,
        Shape::Rect { w: w, h: h } => w * h,
        Shape::Empty => 0.0,
    }
}

fn main() {
    let s = Shape::Empty;
    let a = area(s);
}

