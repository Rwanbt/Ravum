use std::io;

fn mk(x: &str, y: &str) -> [String; 2] {
    return [String::from(x), String::from(y)];
}

fn show(a: &[String; 2]) {
    io::println(a[0].as_str());
}

fn main() {
    let mut a: [String; 2] = mk("a", "b");
    let c: bool = true;
    let s: String = a[0];
    if c {
        a[0] = String::from("z");
    } else {
        a[0] = String::from("y");
    }
    show(&a);
    io::println(s.as_str());
}
