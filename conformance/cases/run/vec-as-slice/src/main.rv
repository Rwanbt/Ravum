use std::io;

fn sum(xs: &[f64]) -> f64 {
    let mut total = 0.0;
    let mut i: usize = 0;
    while i < xs.len() {
        total += xs[i];
        i += 1;
    }
    total
}

fn main() {
    let mut v: Vec<f64> = Vec::new();
    v.push(1.5);
    v.push(2.5);
    let s = sum(v.as_slice());
    let mut out = s.to_string();
    out.push_str(" ");
    out.push_str(&v.as_slice().len().to_string());
    io::println(out.as_str());
}
