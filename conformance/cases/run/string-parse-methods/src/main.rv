use std::io;

fn main() {
    let a = "42".parse_i64();
    let b = "3.5".parse_f64();
    let mut out = String::new();
    match a {
        Result::Ok(v) => out.push_str(&v.to_string()),
        Result::Err(e) => out.push_str("i64-err"),
    }
    out.push_str(" ");
    match b {
        Result::Ok(v) => out.push_str(&v.to_string()),
        Result::Err(e) => out.push_str("f64-err"),
    }
    io::println(out.as_str());
}
