use std::io;

fn mk(x: &str, y: &str) -> [String; 2] {
    return [String::from(x), String::from(y)];
}

fn main() {
    let mut a: [String; 2] = mk("a", "b");
    let c: bool = true;
    {
        a = mk("c", "d");
        if c {
            let s: String = a[0];
            io::println(s.as_str());
        }
        let t: String = a[1];
        io::println(t.as_str());
    }
}
