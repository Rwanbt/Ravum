fn produce(out: Sender<i64>) -> () effects(thread) {
    for i in 0..5 {
        let sent: bool = sync::send(&out, (i as i64) * 10);
        drop(sent);
    }
}

fn main() -> () effects(io, thread, alloc) {
    let c: Channel<i64> = sync::channel();
    let tx: Sender<i64> = sync::sender(&c);
    let tx2: Sender<i64> = sync::clone_sender(&tx);
    let rx: Receiver<i64> = sync::receiver(c);
    let p: JoinHandle<()> = thread::spawn(produce, tx);
    let q: JoinHandle<()> = thread::spawn(produce, tx2);
    let mut sum: i64 = 0;
    let mut count: i64 = 0;
    let mut done: bool = false;
    while !done {
        match sync::recv(&rx) {
            Some(v) => {
                sum = sum + v;
                count = count + 1;
            }
            None => {
                done = true;
            }
        }
    }
    drop(p);
    drop(q);
    io::println(sum.to_string().as_str());
    io::println(count.to_string().as_str());
}
