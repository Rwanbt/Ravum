mod geo {
    pub struct Point { pub x: i32, pub y: i32 }

    impl Point {
        pub fn norme2(&self) -> i32 {
            self.x * self.x + self.y * self.y
        }
    }

    pub fn double(x: i32) -> i32 {
        x * 2
    }
}

use std::io;

fn main() {
    let p = geo::Point { x: 3, y: 4 };
    io::println(&(geo::double(p.norme2())).to_string());
}
